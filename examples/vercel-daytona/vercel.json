{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run typecheck && bun scripts/migrate-deployment.ts",
  "functions": { "api/index.ts": { "maxDuration": 300, "includeFiles": "partner-workflows/**" } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/jobs/drain", "schedule": "* * * * *" }]
}
